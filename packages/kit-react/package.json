{
  "name": "@houheaven/kit-react",
  "version": "0.0.2",
  "description": "后天堂 React 18+ 套件",
  "author": "立树",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/houheaven/hh-kit.git",
    "directory": "packages/kit-react"
  },
  "homepage": "https://github.com/houheaven/hh-kit/tree/main/packages/kit-react#readme",
  "bugs": {
    "url": "https://github.com/houheaven/hh-kit/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./hh-footer": {
      "types": "./dist/hh-footer/index.d.ts",
      "import": "./dist/hh-footer/index.js",
      "require": "./dist/hh-footer/index.cjs"
    },
    "./hh-footer/style.css": "./dist/hh-footer/style.css",
    "./hh-image-dialog": {
      "types": "./dist/hh-image-dialog/index.d.ts",
      "import": "./dist/hh-image-dialog/index.js",
      "require": "./dist/hh-image-dialog/index.cjs"
    },
    "./hh-image-dialog/style.css": "./dist/hh-image-dialog/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@houheaven/kit-assets": "workspace:*",
    "@houheaven/kit-core": "workspace:*",
    "@houheaven/kit-icons": "workspace:*",
    "@houheaven/kit-shared": "workspace:*",
    "@houheaven/kit-styles": "workspace:*",
    "@houheaven/tsconfig": "workspace:*",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vite-plugin-dts": "5.1.0",
    "vite-plugin-lib-inject-css": "^2.2.2"
  }
}