{
  "name": "@houheaven/kit-tokens",
  "version": "0.0.0",
  "private": true,
  "description": "后天堂套件设计变量(色/字/间距)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./css": "./dist/tokens.css",
    "./scss": "./dist/tokens.scss"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@houheaven/tsconfig": "workspace:*",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  }
}
