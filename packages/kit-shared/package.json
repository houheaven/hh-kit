{
  "name": "@houheaven/kit-shared",
  "version": "0.0.0",
  "private": true,
  "description": "跨包共享的工具函数与类型",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@houheaven/tsconfig": "workspace:*",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  }
}
